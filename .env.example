# Copy to .env (git-ignored) with `make .env`. Never commit .env.
# Values below are local-only placeholders for Docker Compose; none is a real credential.

# --- PostgreSQL (used from M2) ---
POSTGRES_PASSWORD=local-postgres-password
PRODUCT_OWNER_PASSWORD=local-product-owner-password
PRODUCT_APP_PASSWORD=local-product-app-password
ORDER_OWNER_PASSWORD=local-order-owner-password
ORDER_APP_PASSWORD=local-order-app-password

# --- LocalStack (used from M2) ---
# Free Hobby-plan token (non-commercial use): https://app.localstack.cloud
LOCALSTACK_AUTH_TOKEN=
# Pinned CalVer tag, 2026.03.0 or later; confirm the exact tag exists in M2.
LOCALSTACK_TAG=2026.03.0
