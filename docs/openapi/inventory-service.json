{
  "components": {
    "schemas": {
      "AvailabilityIn": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/LineIn"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "AvailabilityIn",
        "type": "object"
      },
      "AvailabilityOut": {
        "properties": {
          "available": {
            "title": "Available",
            "type": "boolean"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/LineOut"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "available",
          "items"
        ],
        "title": "AvailabilityOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LineIn": {
        "additionalProperties": false,
        "properties": {
          "quantity": {
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Quantity",
            "type": "integer"
          },
          "sku": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "title": "Sku",
            "type": "string"
          }
        },
        "required": [
          "sku",
          "quantity"
        ],
        "title": "LineIn",
        "type": "object"
      },
      "LineOut": {
        "properties": {
          "available": {
            "title": "Available",
            "type": "integer"
          },
          "owner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The owner; null for the platform or an unknown SKU",
            "title": "Owner"
          },
          "reason": {
            "anyOf": [
              {
                "enum": [
                  "OUT_OF_STOCK",
                  "UNKNOWN_SKU"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "requested": {
            "title": "Requested",
            "type": "integer"
          },
          "sku": {
            "title": "Sku",
            "type": "string"
          },
          "sufficient": {
            "title": "Sufficient",
            "type": "boolean"
          }
        },
        "required": [
          "sku",
          "requested",
          "available",
          "sufficient",
          "reason",
          "owner"
        ],
        "title": "LineOut",
        "type": "object"
      },
      "StockOut": {
        "properties": {
          "available": {
            "title": "Available",
            "type": "integer"
          },
          "owner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The customer who owns it; null while the platform holds it (DESIGN.md 16.1)",
            "title": "Owner"
          },
          "reserved": {
            "title": "Reserved",
            "type": "integer"
          },
          "sku": {
            "title": "Sku",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "sku",
          "available",
          "reserved",
          "updated_at",
          "owner"
        ],
        "title": "StockOut",
        "type": "object"
      },
      "StockSet": {
        "additionalProperties": false,
        "description": "Body of ``PUT /inventory/{sku}``: the new ``available`` quantity.",
        "properties": {
          "available": {
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Available",
            "type": "integer"
          },
          "reset_owner": {
            "default": false,
            "description": "true hands the item back to the platform (removes its owner)",
            "title": "Reset Owner",
            "type": "boolean"
          }
        },
        "required": [
          "available"
        ],
        "title": "StockSet",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "inventory-service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/inventory/availability": {
      "post": {
        "description": "Advisory only: the reservation made from the OrderCreated event is authoritative.",
        "operationId": "check_availability_api_v1_inventory_availability_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AvailabilityIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Check Availability"
      }
    },
    "/api/v1/inventory/{sku}": {
      "get": {
        "operationId": "get_stock_api_v1_inventory__sku__get",
        "parameters": [
          {
            "in": "path",
            "name": "sku",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
              "title": "Sku",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Stock"
      },
      "put": {
        "description": "Admin/seed: sets ``available`` (creating the record if needed), keeps ``reserved``, and\nkeeps the owner unless ``reset_owner``.",
        "operationId": "set_stock_api_v1_inventory__sku__put",
        "parameters": [
          {
            "in": "path",
            "name": "sku",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
              "title": "Sku",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StockSet"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Set Stock"
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Live Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live"
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready"
      }
    }
  }
}
