            "type": "integer"
          },
          "sku": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "title": "Sku",
            "type": "string"
          }
        },
        "required": [
          "sku",
          "quantity"
        ],
        "title": "LineIn",
        "type": "object"
      },
      "OrderCreate": {
        "additionalProperties": false,
        "properties": {
          "customer_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
            "title": "Customer Id",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/LineIn"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "customer_id",
          "items"
        ],
        "title": "OrderCreate",
        "type": "object"
      },
      "OrderOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "customer_id": {
            "title": "Customer Id",
            "type": "string"
          },
          "items": {
